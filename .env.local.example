# ==============================================================================
# Supabase Configuration
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# ==============================================================================

# Your unique project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your project's anon/public key (safe for client-side use with RLS enabled)
# NEVER put your service_role key here or anywhere in client-accessible code!
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
